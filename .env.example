# --- Travelpayouts Data API (flights: cached "recently found" fares) ---
# Free registration at https://www.travelpayouts.com/ -> Tools/API section
# for a token. Its companion Hotellook hotel API is discontinued — see README.
TRAVELPAYOUTS_TOKEN=

# --- Duffel (live, exact-date flights) ---
# Requires a LIVE, "Read and write" scoped token (duffel_live_..., not
# duffel_test_... which only returns fake sandbox data). "Read and write"
# is required even for search-only use — Duffel treats creating a search
# as a write action. Getting a live token means activating your Duffel
# account with identity/payment details first. See README §2.
# Note: Duffel Stays (hotels) is sales-gated, not self-service — this
# token only powers flight search here, see LITEAPI_KEY below for hotels.
DUFFEL_TOKEN=

# --- LiteAPI / Nuitée (hotel search) ---
# Free sandbox signup at https://www.liteapi.travel/, no credit card. See
# README for whether the sandbox key (sand_...) returns real data.
LITEAPI_KEY=

# Default currency for price results
CURRENCY=GBP

# --- Optional: Amadeus (Enterprise access only — see README) ---
# Amadeus discontinued the free Self-Service API on 17 Jul 2026. These only
# do anything if you have separately-approved Amadeus Enterprise API
# credentials. Leave blank otherwise — the tracker skips Amadeus cleanly.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Optional: email alerts when a new lowest price is found ---
# Leave these unset to disable email alerts (tracker still logs deals to the terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

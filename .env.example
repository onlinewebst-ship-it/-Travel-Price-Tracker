# Amadeus for Developers — Self-Service API credentials
# Get free test-tier keys at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# Amadeus test API base URL (free tier). Switch to the production host
# (api.amadeus.com) only once you've moved to a paid production API key.
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Default currency for price results
CURRENCY=GBP

# --- Optional: email alerts when a new lowest price is found ---
# Leave these unset to disable email alerts (tracker still logs deals to the terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

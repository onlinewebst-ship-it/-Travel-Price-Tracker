# --- Primary price source: Travelpayouts Data API + Hotellook ---
# Free registration at https://www.travelpayouts.com/ -> Tools/API section
# for a token. Required for the tracker to do anything useful now that
# Amadeus's free API is gone (see README).
TRAVELPAYOUTS_TOKEN=

# Default currency for price results
CURRENCY=GBP

# --- Optional: Amadeus (Enterprise access only — see README) ---
# Amadeus discontinued the free Self-Service API on 17 Jul 2026. These only
# do anything if you have separately-approved Amadeus Enterprise API
# credentials. Leave blank otherwise — the tracker skips Amadeus cleanly.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Optional: email alerts when a new lowest price is found ---
# Leave these unset to disable email alerts (tracker still logs deals to the terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
